{
  "name": "edu-user-capture-app",
  "appId": "com.eduusercapture.app",
  "productName": "Edu User Capture",
  "version": "1.24.1",
  "description": "Edu User Capture - Aplicación de captura de imágenes de usuarios",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "predev": "node scripts/build-receipt-printer.mjs --optional",
    "dev": "electron . --dev",
    "clean": "node -e \"require('fs').rmSync('node_modules', {recursive:true, force:true}); require('fs').rmSync('dist', {recursive:true, force:true}); require('fs').rmSync('build', {recursive:true, force:true})\"",
    "clean:dist": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true}); require('fs').rmSync('build', {recursive:true, force:true})\"",
    "install:clean": "npm run clean && npm ci",
    "build:receipt-printer": "node scripts/build-receipt-printer.mjs",
    "predist:win": "npm run build:receipt-printer",
    "dist:win": "electron-builder --win nsis --x64",
    "predist:unpacked": "npm run build:receipt-printer",
    "dist:unpacked": "electron-builder --win dir --x64",
    "predist:win:portable": "npm run build:receipt-printer",
    "dist:win:portable": "electron-builder --win portable --x64",
    "predist:win:zip": "npm run build:receipt-printer",
    "dist:win:zip": "electron-builder --win zip --x64",
    "dist:mac": "electron-builder --mac dmg --x64",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "postinstall": "node scripts/build-receipt-printer.mjs --optional",
    "release": "commit-and-tag-version",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "prerelease:publish": "npm run build:receipt-printer",
    "release:publish": "git push --follow-tags origin main && node scripts/release-notes.mjs && electron-builder --win nsis --x64 --publish always",
    "release:notes": "node scripts/release-notes.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc -p .",
    "test:unit": "jest tests/unit",
    "test:performance": "jest tests/unit/table/virtualScroll.performance.test.js"
  },
  "keywords": [
    "electron"
  ],
  "author": "Víctor Pineda Ribes",
  "dependencies": {
    "archiver": "^7.0.1",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^4.5.7",
    "markdown-it": "^15.0.3",
    "pdfkit": "^0.17.2",
    "sharp": "^0.34.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/archiver": "7.0.0",
    "@types/node": "24.19.2",
    "@types/pdfkit": "0.17.7",
    "acorn": "8.15.0",
    "commit-and-tag-version": "^13.3.0",
    "cross-env": "^10.1.0",
    "electron": "^44.10.0",
    "electron-builder": "^26.18.0",
    "electron-reloader": "^1.2.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.eduusercaptureapp.app",
    "productName": "Edu User Capture",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "assets/**/*",
      "src/**/*",
      "!dist/**/*",
      "!build/**/*",
      "!.vscode/**/*",
      "!**/*.map",
      "!**/test{,s}/**/*",
      "!**/__tests__/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "moon-brain",
      "repo": "user-capture-app",
      "releaseType": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/sqlite3/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/receipt-printer/ReceiptPrinter.exe",
          "to": "receipt-printer/ReceiptPrinter.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png"
    }
  },
  "license": "CC-BY-NC-4.0"
}
